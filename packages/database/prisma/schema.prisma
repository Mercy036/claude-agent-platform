datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PARTICIPANT
}

enum SessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  username     String?  @unique
  password     String
  team         String?
  role         Role     @default(PARTICIPANT)
  status       String   @default("ACTIVE") // ACTIVE, DISABLED
  tokenLimit   Int      @default(1000000)
  tokensUsed   Int      @default(0)
  tokensReserved Int    @default(0)
  authVersion  Int      @default(0)
  
  sessions     AgentSession[]
  usageRecords TokenUsage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AgentSession {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         SessionStatus @default(QUEUED)
  environmentId  String?
  tokensUsed     Int           @default(0)
  tokensReserved Int           @default(0)
  quotaKey       String
  request        Json?
  inputTokens    Int           @default(0)
  maxOutputTokens Int          @default(0)
  settledAt      DateTime?
  
  startedAt      DateTime?
  endedAt        DateTime?
  lastActivity   DateTime?
  
  usageRecords   TokenUsage[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([quotaKey])
}

model TokenUsage {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  sessionId           String
  session             AgentSession @relation(fields: [sessionId], references: [id])
  requestId           String       @unique
  providerRequestId   String?
  estimated           Boolean      @default(false)
  
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int
  cacheCreationTokens Int
  totalTokens         Int
  
  model               String
  timestamp           DateTime     @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Setting {
  key   String @id
  value String
}

model Team {
  id                    String   @id @default(uuid())
  name                  String   @unique
  status                String   @default("ACTIVE")
  creditMicros          Int      @default(10000000)
  spentMicros           Int      @default(0)
  reservedMicros        Int      @default(0)
  maxConcurrentRequests Int      @default(2)
  requestsPerMinute     Int      @default(60)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  keys                  TeamApiKey[]
  requests              GatewayRequest[]
  creditChanges         TeamCreditChange[]
}

model TeamApiKey {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  name       String
  keyHash    String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  requests   GatewayRequest[]
  @@index([teamId])
}

model GatewayRequest {
  id                    String    @id @default(uuid())
  teamId                String
  team                  Team      @relation(fields: [teamId], references: [id])
  keyId                 String
  key                   TeamApiKey @relation(fields: [keyId], references: [id])
  model                 String
  status                String    @default("RESERVED")
  reservedMicros        Int
  chargedMicros         Int       @default(0)
  inputRateMicros        Int
  outputRateMicros       Int
  inputBudget           Int
  maxOutputTokens       Int
  inputTokens           Int       @default(0)
  outputTokens          Int       @default(0)
  estimated             Boolean   @default(false)
  providerRequestId     String?
  createdAt             DateTime  @default(now())
  lastActivity          DateTime  @default(now())
  settledAt             DateTime?
  @@index([teamId, createdAt])
  @@index([settledAt, lastActivity])
}

model TeamCreditChange {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  amountMicros Int
  note        String
  adminId     String
  createdAt   DateTime @default(now())
  @@index([teamId, createdAt])
}
