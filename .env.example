# PostgreSQL and Redis (local development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/claude_hackathon"
REDIS_URL="redis://localhost:6379"

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
CORS_ORIGINS="http://localhost:3000"
PORT="3001"

# Anthropic is the implemented provider
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
MAX_CONCURRENT_AGENTS="5"
ENABLE_CODING_ASSISTANT="false"

# Team API gateway: default model prices are Haiku 4.5 ($1 input / $5 output per million tokens)
GATEWAY_MAX_CONCURRENT_REQUESTS="5"
GATEWAY_MAX_OUTPUT_TOKENS="8192"
# Optional, replace the entire model allowlist and prices. One microdollar = $0.000001.
# GATEWAY_MODEL_PRICES_JSON={"claude-haiku-4-5":{"inputMicrosPerToken":1,"outputMicrosPerToken":5}}

# Required for db:seed; no default admin credentials are created
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# CLI: HTTPS required for remote endpoints
HACKATHON_API_URL="http://localhost:3001"

# Dashboard: set in apps/admin/.env.local or hosting environment BEFORE building
NEXT_PUBLIC_API_URL="http://localhost:3001"
